# Utilisé uniquement par la version web (server/index.ts).
# Jeton OpenLegi : https://auth.openlegi.fr › Dashboard › onglet Connexion › « Votre token API ».
# Le jeton seul ou l'URL complète du connecteur (…/legifrance/mcp?token=…) sont acceptés.
OPENLEGI_TOKEN=
# Facultatif — IA gratuite pour rédiger les synthèses (sans elle : extraits des décisions).
# Ollama Cloud (prioritaire si renseigné) : clé sur https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Ollama installé localement (utilisé si OLLAMA_API_KEY est vide)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Facultatif et payant — active le moteur Claude : https://platform.claude.com
ANTHROPIC_API_KEY=
# Dossier de la base locale des décisions
DATA_DIR=data
# Optionnel : si défini, l'interface web demande ce code avant d'utiliser l'API
# (évite qu'un inconnu consomme vos quotas si le site est public).
APP_ACCESS_CODE=
PORT=8787
